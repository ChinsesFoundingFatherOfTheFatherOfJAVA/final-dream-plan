{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://final-dream.local/schemas/drill-script-v1.schema.json",
  "title": "DrillScriptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "scenarioId",
    "practiceType",
    "studyMode",
    "difficulty",
    "scene",
    "userRole",
    "actor",
    "goals",
    "evaluation",
    "runtime",
    "productProfileKeys"
  ],
  "properties": {
    "schemaVersion": { "const": "drill-script-v1" },
    "attemptId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "practiceType": { "enum": ["case", "random", "custom"] },
    "studyMode": { "enum": [1, 2] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "narration", "background", "openingLine"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "narration": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 1 },
        "openingLine": { "type": "string", "minLength": 1 },
        "location": { "type": ["string", "null"] },
        "timeLabel": { "type": ["string", "null"] }
      }
    },
    "userRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity", "background", "forbiddenBehaviors"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "ageRange": { "type": ["string", "null"] },
        "background": { "type": "string", "minLength": 1 },
        "allowedResources": { "type": "array", "items": { "type": "string" } },
        "forbiddenBehaviors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "identity",
        "personality",
        "communicationStyle",
        "explicitGoals",
        "implicitGoals",
        "hiddenFacts",
        "behaviorPatterns"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ageRange": { "type": ["string", "null"] },
        "personality": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "communicationStyle": { "type": "string", "minLength": 1 },
        "explicitGoals": { "type": "array", "items": { "type": "string" } },
        "implicitGoals": { "type": "array", "items": { "type": "string" } },
        "hiddenFacts": { "type": "array", "items": { "type": "string" } },
        "behaviorPatterns": { "type": "array", "items": { "type": "string" } },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string" },
            "voiceId": { "type": "string" },
            "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
          }
        },
        "avatarPrompt": { "type": ["string", "null"] }
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practiceGoal", "behaviorGuidance", "failureSignals"],
      "properties": {
        "practiceGoal": { "type": "string", "minLength": 1 },
        "behaviorGuidance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "failureSignals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passScore", "dimensions"],
      "properties": {
        "passScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "weight", "description"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "weight": { "type": "number", "minimum": 0, "maximum": 100 },
              "description": { "type": "string", "minLength": 1 },
              "excellentStandard": { "type": ["string", "null"] },
              "goodStandard": { "type": ["string", "null"] },
              "improveStandard": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationSeconds", "maxRounds", "targetProgressMode"],
      "properties": {
        "maxDurationSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetProgressMode": { "enum": ["milestones", "binary"] }
      }
    },
    "productProfileKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^pp_[A-Za-z0-9_-]{8,48}$"
      }
    },
    "generatedAt": { "type": "string" }
  }
}
